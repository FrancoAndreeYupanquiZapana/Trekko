{
  "expo": {
    "name": "Trekko",
    "slug": "trekko",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/trekko-logo.png",
    "scheme": "trekko",
    "userInterfaceStyle": "automatic",
    "autolinking": {
      "exclude": [
        "react-native-worklets",
        "react-native-reanimated",
        "react-native-gesture-handler"
      ]
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.trekko"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trekko usa tu ubicación para dibujar tu recorrido y georreferenciar tus fotos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trekko accede a tus fotos para que elijas las mejores del día.",
          "cameraPermission": "Trekko usa la cámara para capturar tus fotos del recorrido.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
