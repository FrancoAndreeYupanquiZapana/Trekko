# Puerto del servidor
PUERTO=4000

# Credenciales de Supabase (panel de tu proyecto en supabase.com)
# OJO: usa la clave "service_role", NO la "anon" (ver Settings > API keys).
SUPABASE_URL=TU_URL_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE_SUPABASE

# OPCIONAL — IA de Gemini (puntaje de fotos y frase del recuerdo).
# Consigue tu clave en https://aistudio.google.com/apikey (empieza con "AIza").
GEMINI_API_KEY=
# Modelo a usar (opcional; por defecto gemini-3.5-flash).
GEMINI_MODELO=gemini-3.5-flash